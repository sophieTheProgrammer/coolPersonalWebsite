---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomePersonFigure from "../components/HomePersonFigure.astro";
import { homeContent } from "../data/site";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title="Cool Personal Website">
  <main class="min-h-screen overflow-hidden px-6 py-16 sm:px-10">
    <section class="mx-auto grid min-h-[78vh] max-w-6xl items-center gap-16 lg:grid-cols-[1.28fr_0.72fr]">
      <div class="relative">
        <div class="hero-with-person">
          <h1 class="max-w-3xl text-5xl font-black leading-[0.95] sm:text-7xl">
            {homeContent.headline}
          </h1>
          <HomePersonFigure src={homeContent.studioAvatarDoodle} />
        </div>

        <div class="home-social-links mt-6 flex flex-wrap gap-3">
          {
            homeContent.socialLinks.map((link) => (
              <a
                class:list={[
                  "home-social-card group rounded-md bg-[var(--color-card)] px-4 py-3 transition hover:-translate-y-0.5",
                  link.kind === "youtube" ? "home-social-card--youtube" : "home-social-card--github",
                ]}
                href={link.href}
                target="_blank"
                rel="noreferrer"
              >
                <span class="home-social-card__icon" aria-hidden="true">
                  <span></span>
                </span>
                <span class="block font-black">{link.label}</span>
              </a>
            ))
          }
        </div>
      </div>

      <div class="relative rounded-xl bg-white/48 p-3 sm:p-4">
        <div class="grid gap-3">
          {
            homeContent.sections.map((section, index) => (
              <a
                class:list={[
                  "home-section-card rounded-lg bg-white/46 p-5 transition hover:bg-white/82",
                  index === 0 && "home-section-card--wide min-h-48 content-end bg-[rgba(217,79,104,0.12)] p-7",
                  index === 1 && "home-section-card--tilt-left",
                  index === 2 && "home-section-card--tilt-right",
                ]}
                href={`${base}${section.href}`}
              >
                <span class:list={["block font-black leading-none", section.featured ? "text-4xl" : "text-xl"]}>
                  {section.title}
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
