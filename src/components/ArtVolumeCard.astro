---
import type { ArtVolume } from "../data/artworks";
import { getArtworksForVolume } from "../data/artworks";

type Props = {
  volume: ArtVolume;
};

const { volume } = Astro.props;
const drawings = getArtworksForVolume(volume.slug);
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const previewDrawings = drawings
  .filter((drawing) => drawing.imageSrc && !drawing.imageSrc.toLowerCase().endsWith(".pdf"))
  .sort((left, right) => Number(Boolean(right.featured)) - Number(Boolean(left.featured)))
  .slice(0, 1);
const getImageSrc = (src?: string) =>
  src?.startsWith("/") ? `${base}${src.slice(1)}` : src;
---

<article
  class="art-volume-card site-card site-card--interactive group overflow-hidden"
>
  <a class="art-volume-card__link" href={`${base}art/collections/${volume.slug}/`}>
    <div
      class="art-volume-card__preview art-volume-card__preview--single"
      aria-hidden="true"
    >
      {
        previewDrawings.length > 0 ? (
          previewDrawings.map((drawing, index) => (
            <div class:list={["art-volume-card__image", index === 0 && "art-volume-card__image--primary"]}>
              <img src={getImageSrc(drawing.imageSrc)} alt="" loading="lazy" />
            </div>
          ))
        ) : (
          <div
            class="art-volume-card__image art-volume-card__image--primary"
            style={`background: linear-gradient(135deg, ${drawings[0]?.palette[0]}, ${drawings[0]?.palette[1]} 58%, ${drawings[0]?.palette[2]});`}
          ></div>
        )
      }
    </div>

    <div class="art-volume-card__body">
      <p class="art-volume-card__date">{volume.year}</p>
      <h2>{volume.title}</h2>
    </div>
  </a>
</article>
