---
import type { ArtVolume } from "../data/artworks";
import { getArtworksForVolume } from "../data/artworks";

type Props = {
  volume: ArtVolume;
  index: number;
};

const { volume, index } = Astro.props;
const drawings = getArtworksForVolume(volume.slug);
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<article
  class:list={[
    "art-volume-card group overflow-hidden rounded-xl bg-[rgba(255,253,248,0.92)] transition hover:-translate-y-1 hover:shadow-lg",
    index === 0 ? "xl:col-span-2" : "",
  ]}
>
  <a class="block h-full" href={`${base}art/collections/${volume.slug}/`}>
    <div class:list={["grid gap-5", index === 0 ? "p-6" : "p-4"]}>
      <div>
        <p class="font-mono text-xs font-bold text-[var(--color-muted)]">
          {volume.year} / {drawings.length} drawings
        </p>
        <h2 class:list={["mt-4 font-black", index === 0 ? "text-4xl leading-none" : "text-2xl"]}>{volume.title}</h2>
        <p class="mt-3 leading-7 text-[var(--color-muted)]">{volume.subtitle}</p>
      </div>

      <div class="grid gap-2">
        {
          drawings.slice(0, 4).map((drawing) => (
            <p class="truncate rounded-md bg-white/45 px-3 py-2 text-sm font-bold text-[var(--color-muted)] transition group-hover:bg-white/70">
              {drawing.title}
            </p>
          ))
        }
      </div>

      <p class="leading-7 text-[var(--color-muted)]">{volume.note}</p>
    </div>
  </a>
</article>
