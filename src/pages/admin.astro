---
import BaseLayout from "../layouts/BaseLayout.astro";
import { artVolumes } from "../data/artworks";
import { skillToys } from "../data/skillToys";
---

<BaseLayout
  title="Admin Helper | Cool Personal Website"
  description="A local helper page for writing art uploads and generating skill toy data snippets."
>
  <main class="admin-page page-shell">
    <section class="content-frame">
      <h1 class="text-4xl font-black leading-none sm:text-6xl">
        Add stuff locally
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-[var(--color-muted)]">
        Start the local writer with <code>npm run admin:server</code>, then upload
        art files into <code>public/art/</code> and attach image uploads to packets.
      </p>

      <div class="admin-workbench section-rhythm--tight">
        <form class="admin-card admin-panel site-card admin-panel--art" data-art-upload-form>
          <div class="admin-panel__header">
            <h2 class="text-3xl leading-none">Upload art</h2>
            <p>PDF pages can be renamed, paired, and saved into a new or existing packet.</p>
          </div>

          <div class="admin-field-grid">
            <label class="field-stack">
              <span>Image or PDF</span>
              <input class="form-field" name="file" type="file" accept="image/*,.pdf" required />
            </label>
            <label class="field-stack">
              <span>Packet</span>
              <select class="form-field" name="packetSlug">
                {artVolumes.map((volume) => <option value={volume.slug}>{volume.title}</option>)}
              </select>
            </label>
            <label class="field-stack">
              <span>New packet title for PDF</span>
              <input class="form-field" name="newPacketTitle" placeholder="Leave blank to use selected packet" />
            </label>
            <label class="field-stack">
              <span>Drawing title</span>
              <input class="form-field" name="title" placeholder="Sketchbook scan" required />
            </label>
            <label class="field-stack admin-field-grid__wide">
              <span>Note</span>
              <textarea class="form-field form-field--textarea" name="note" placeholder="Optional tiny note"></textarea>
            </label>
            <label class="field-stack admin-field-grid__wide">
              <span>Process/sketch image path</span>
              <input class="form-field" name="processSrc" placeholder="/art/sketch-upload.png" />
            </label>
          </div>

          <div class="media-frame admin-upload-preview" data-upload-preview>
            <span>Select an image or PDF</span>
          </div>
          <div class="admin-pdf-pages" data-pdf-pages hidden></div>
          <div class="flex flex-wrap gap-2">
            <button class="site-button site-button--dark px-4 py-3" type="submit">
              Upload file
            </button>
            <button class="site-button px-4 py-3" type="button" data-save-artwork disabled>
              Save to packet
            </button>
          </div>
          <pre class="admin-output" data-art-output>Writer status will appear here.</pre>
        </form>

        <form class="admin-card admin-panel site-card" data-trick-form>
          <div class="admin-panel__header">
            <h2 class="text-3xl leading-none">YouTube clip</h2>
          </div>
          <label class="field-stack">
            <span>Toy</span>
            <select class="form-field" name="toySlug">
              {skillToys.map((toy) => <option value={toy.slug}>{toy.name}</option>)}
            </select>
          </label>
          <label class="field-stack">
            <span>YouTube URL or ID</span>
            <input class="form-field" name="youtube" placeholder="https://youtu.be/..." required />
          </label>
          <label class="field-stack">
            <span>Title</span>
            <input class="form-field" name="title" placeholder="Leave as YouTube title later" />
          </label>
          <label class="field-stack">
            <span>Notes</span>
            <textarea class="form-field form-field--textarea" name="notes" placeholder="Leave as YouTube description later"></textarea>
          </label>
          <button class="site-button site-button--dark" type="submit">Generate trick snippet</button>
          <pre class="admin-output" data-trick-output></pre>
        </form>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import * as pdfjsLib from "pdfjs-dist";
  import pdfWorkerSrc from "pdfjs-dist/build/pdf.worker.mjs?url";

  pdfjsLib.GlobalWorkerOptions.workerSrc = pdfWorkerSrc;

  const writerUrl = "http://localhost:8787";

  const slugify = (value: string) =>
    value
      .toLowerCase()
      .trim()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-|-$/g, "");

  const getYouTubeId = (value: string) => {
    try {
      const parsed = new URL(value);
      if (parsed.hostname.includes("youtu.be")) {
        return parsed.pathname.split("/").filter(Boolean)[0] ?? value;
      }
      if (parsed.pathname.startsWith("/shorts/")) {
        return parsed.pathname.split("/").filter(Boolean)[1] ?? value;
      }
      return parsed.searchParams.get("v") ?? value;
    } catch {
      return value;
    }
  };

  const artForm = document.querySelector("[data-art-upload-form]");
  const artOutput = document.querySelector("[data-art-output]");
  const saveArtworkButton = document.querySelector("[data-save-artwork]");
  const preview = document.querySelector("[data-upload-preview]");
  const pdfPagesPreview = document.querySelector("[data-pdf-pages]");
  const packetSelect = document.querySelector<HTMLSelectElement>('[name="packetSlug"]');
  const newPacketInput = document.querySelector<HTMLInputElement>('[name="newPacketTitle"]');
  let uploadedFile: { src: string; kind: "image" | "pdf" } | null = null;
  type RenderedPdfPage = {
    pageNumber: number;
    dataUrl: string;
    width: number;
    height: number;
  };

  type PdfPagePayload = RenderedPdfPage & {
    title: string;
    role: "final" | "process";
    processPageNumber?: number;
  };

  let renderedPdfPages: RenderedPdfPage[] = [];

  const writeOutput = (message: string) => {
    if (artOutput instanceof HTMLElement) {
      artOutput.textContent = message;
    }
  };

  const renderPdfPages = async (file: File) => {
    if (!(pdfPagesPreview instanceof HTMLElement)) return;

    renderedPdfPages = [];
    pdfPagesPreview.hidden = false;
    pdfPagesPreview.textContent = "Rendering PDF pages...";

    const bytes = new Uint8Array(await file.arrayBuffer());
    const pdf = await pdfjsLib.getDocument({ data: bytes }).promise;
    const pages: RenderedPdfPage[] = [];

    pdfPagesPreview.innerHTML = "";

    for (let pageNumber = 1; pageNumber <= pdf.numPages; pageNumber += 1) {
      const page = await pdf.getPage(pageNumber);
      const baseViewport = page.getViewport({ scale: 1 });
      const scale = Math.min(2.6, 1800 / Math.max(baseViewport.width, baseViewport.height));
      const viewport = page.getViewport({ scale });
      const canvas = document.createElement("canvas");
      const context = canvas.getContext("2d");
      if (!context) continue;

      canvas.width = Math.ceil(viewport.width);
      canvas.height = Math.ceil(viewport.height);
      context.fillStyle = "#ffffff";
      context.fillRect(0, 0, canvas.width, canvas.height);
      await page.render({ canvas, canvasContext: context, viewport }).promise;

      const dataUrl = canvas.toDataURL("image/png");
      pages.push({ pageNumber, dataUrl, width: canvas.width, height: canvas.height });

      const pageCard = document.createElement("article");
      pageCard.className = "admin-pdf-page";
      pageCard.dataset.pdfPage = String(pageNumber);

      const includeLabel = document.createElement("label");
      includeLabel.className = "admin-pdf-page__include";

      const checkbox = document.createElement("input");
      checkbox.type = "checkbox";
      checkbox.value = String(pageNumber);
      checkbox.checked = true;
      checkbox.dataset.pdfInclude = String(pageNumber);

      const includeText = document.createElement("span");
      includeText.textContent = `Include page ${pageNumber}`;

      includeLabel.append(checkbox, includeText);

      const image = document.createElement("img");
      image.src = dataUrl;
      image.alt = `PDF page ${pageNumber}`;

      const meta = document.createElement("p");
      meta.className = "admin-pdf-page__meta";
      meta.textContent = `${canvas.width}x${canvas.height}`;

      const controls = document.createElement("div");
      controls.className = "admin-pdf-page__controls";

      const titleLabel = document.createElement("label");
      titleLabel.className = "field-stack";
      const titleText = document.createElement("span");
      titleText.textContent = "Title";
      const titleInput = document.createElement("input");
      titleInput.className = "form-field";
      titleInput.dataset.pdfTitle = String(pageNumber);
      titleInput.value = `${file.name.replace(/\.[^.]+$/, "")} p. ${pageNumber}`;
      titleLabel.append(titleText, titleInput);

      const roleLabel = document.createElement("label");
      roleLabel.className = "field-stack";
      const roleText = document.createElement("span");
      roleText.textContent = "Use as";
      const roleSelect = document.createElement("select");
      roleSelect.className = "form-field";
      roleSelect.dataset.pdfRole = String(pageNumber);
      roleSelect.innerHTML = `
        <option value="final">finished/gallery image</option>
        <option value="process">process/hover image</option>
      `;
      roleLabel.append(roleText, roleSelect);

      const processLabel = document.createElement("label");
      processLabel.className = "field-stack";
      const processText = document.createElement("span");
      processText.textContent = "Hover image";
      const processSelect = document.createElement("select");
      processSelect.className = "form-field";
      processSelect.dataset.pdfProcessFor = String(pageNumber);
      processLabel.append(processText, processSelect);

      controls.append(titleLabel, roleLabel, processLabel);
      pageCard.append(includeLabel, image, meta, controls);
      pdfPagesPreview.append(pageCard);
    }

    renderedPdfPages = pages;
    syncPdfProcessSelectors();
    writeOutput(`Rendered ${pages.length} PDF page${pages.length === 1 ? "" : "s"} for packet import.`);
  };

  const syncPdfProcessSelectors = () => {
    if (!(pdfPagesPreview instanceof HTMLElement)) return;

    const processOptions = renderedPdfPages.filter((page) => {
      const role = pdfPagesPreview.querySelector<HTMLSelectElement>(`[data-pdf-role="${page.pageNumber}"]`);
      const include = pdfPagesPreview.querySelector<HTMLInputElement>(`[data-pdf-include="${page.pageNumber}"]`);
      return include?.checked && role?.value === "process";
    });

    pdfPagesPreview.querySelectorAll<HTMLSelectElement>("[data-pdf-process-for]").forEach((select) => {
      const pageNumber = Number(select.dataset.pdfProcessFor);
      const currentValue = select.value;
      const role = pdfPagesPreview.querySelector<HTMLSelectElement>(`[data-pdf-role="${pageNumber}"]`);

      select.innerHTML = `<option value="">none</option>`;
      processOptions
        .filter((page) => page.pageNumber !== pageNumber)
        .forEach((page) => {
          const title = pdfPagesPreview.querySelector<HTMLInputElement>(`[data-pdf-title="${page.pageNumber}"]`)?.value.trim();
          const option = document.createElement("option");
          option.value = String(page.pageNumber);
          option.textContent = title ? `Page ${page.pageNumber}: ${title}` : `Page ${page.pageNumber}`;
          select.append(option);
        });

      select.value = currentValue;
      select.disabled = role?.value === "process";
    });
  };

  const selectPacket = (slug: string, title?: string) => {
    if (!packetSelect || !slug) return;

    let option = Array.from(packetSelect.options).find((item) => item.value === slug);

    if (!option) {
      option = new Option(title || slug, slug);
      packetSelect.append(option);
    } else if (title) {
      option.textContent = title;
    }

    packetSelect.value = slug;
  };

  const handlePdfPageControlUpdate = (event: Event) => {
    const target = event.target;

    if (
      target instanceof HTMLSelectElement ||
      target instanceof HTMLInputElement
    ) {
      syncPdfProcessSelectors();
    }
  };

  pdfPagesPreview?.addEventListener("change", handlePdfPageControlUpdate);
  pdfPagesPreview?.addEventListener("input", handlePdfPageControlUpdate);

  const renderPreview = async (file: File) => {
    if (!(preview instanceof HTMLElement)) return;
    const url = URL.createObjectURL(file);
    renderedPdfPages = [];

    if (pdfPagesPreview instanceof HTMLElement) {
      pdfPagesPreview.hidden = true;
      pdfPagesPreview.innerHTML = "";
    }

    if (file.type === "application/pdf") {
      preview.innerHTML = `<iframe title="PDF preview" src="${url}"></iframe>`;
      await renderPdfPages(file);
      return;
    }

    preview.innerHTML = `<img src="${url}" alt="Upload preview" />`;
  };

  artForm?.querySelector<HTMLInputElement>('input[type="file"]')?.addEventListener("change", async (event) => {
    const input = event.currentTarget;
    if (!(input instanceof HTMLInputElement)) return;
    const file = input.files?.[0];
    uploadedFile = null;

    if (saveArtworkButton instanceof HTMLButtonElement) {
      saveArtworkButton.disabled = true;
    }

    if (file) {
      await renderPreview(file);
      writeOutput(`Ready to upload: ${file.name}`);
    }
  });

  artForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const form = event.currentTarget;
    if (!(form instanceof HTMLFormElement)) return;

    const data = new FormData(form);
    writeOutput("Uploading to local writer...");

    try {
      const response = await fetch(`${writerUrl}/api/upload`, {
        method: "POST",
        body: data,
      });
      const result = await response.json();
      if (!result.ok) throw new Error(result.error);

      uploadedFile = result.file;
      if (saveArtworkButton instanceof HTMLButtonElement) {
        saveArtworkButton.disabled = false;
      }

      writeOutput(
        uploadedFile?.kind === "pdf"
          ? `Uploaded ${result.file.src}\nReady to save this PDF into the selected packet.`
          : `Uploaded ${result.file.src}\nReady to save this image into the selected packet.`,
      );
    } catch (error) {
      writeOutput(`Writer unavailable or failed.\nRun: npm run admin:server\n\n${error}`);
    }
  });

  saveArtworkButton?.addEventListener("click", async () => {
    if (!(artForm instanceof HTMLFormElement) || !uploadedFile) {
      return;
    }

    const data = new FormData(artForm);
    writeOutput("Writing drawing data...");

    try {
      if (uploadedFile.kind === "pdf") {
        const selectedPageNumbers = new Set(
          Array.from(document.querySelectorAll<HTMLInputElement>("[data-pdf-include]:checked"))
            .map((input) => Number(input.value)),
        );
        const pages: PdfPagePayload[] = renderedPdfPages
          .filter((page) => selectedPageNumbers.has(page.pageNumber))
          .map((page) => {
            const titleInput = document.querySelector<HTMLInputElement>(`[data-pdf-title="${page.pageNumber}"]`);
            const roleInput = document.querySelector<HTMLSelectElement>(`[data-pdf-role="${page.pageNumber}"]`);
            const processInput = document.querySelector<HTMLSelectElement>(`[data-pdf-process-for="${page.pageNumber}"]`);
            const role = roleInput?.value === "process" ? "process" : "final";

            return {
              ...page,
              title: titleInput?.value.trim() || `${String(data.get("title") ?? "PDF page")} p. ${page.pageNumber}`,
              role,
              processPageNumber: role === "final" && processInput?.value
                ? Number(processInput.value)
                : undefined,
            };
          });

        const response = await fetch(`${writerUrl}/api/pdf-pages`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            packetSlug: data.get("packetSlug"),
            newPacketTitle: data.get("newPacketTitle"),
            title: data.get("title"),
            note: data.get("note"),
            pages,
          }),
        });
        const result = await response.json();
        if (!result.ok) throw new Error(result.error);

        selectPacket(result.artwork.packetSlug, result.artwork.packetTitle);
        if (result.artwork.createdPacket && newPacketInput) {
          newPacketInput.value = "";
        }

        writeOutput(`Saved PDF pages to ${result.artwork.packetTitle || result.artwork.packetSlug}: ${result.artwork.slugs.join(", ")}\nThe packet selector now points at that packet.`);
        return;
      }

      const response = await fetch(`${writerUrl}/api/artwork`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          packetSlug: data.get("packetSlug"),
          title: data.get("title"),
          note: data.get("note"),
          imageSrc: uploadedFile.src,
          processSrc: data.get("processSrc"),
          kind: uploadedFile.kind,
        }),
      });
      const result = await response.json();
      if (!result.ok) throw new Error(result.error);

      writeOutput(`Saved drawing: ${result.artwork.slug}\nRun npm run build or refresh dev server to see it.`);
    } catch (error) {
      writeOutput(`Could not save drawing.\n${error}`);
    }
  });

  document.querySelector("[data-trick-form]")?.addEventListener("submit", (event) => {
    event.preventDefault();
    const form = event.currentTarget;
    if (!(form instanceof HTMLFormElement)) return;

    const data = new FormData(form);
    const toySlug = String(data.get("toySlug") ?? "");
    const youtubeId = getYouTubeId(String(data.get("youtube") ?? "").trim());
    const title = String(data.get("title") ?? "").trim() || "YouTube title";
    const notes = String(data.get("notes") ?? "").trim() || "YouTube description";
    const today = new Date().toISOString().slice(0, 10);
    const output = form.querySelector("[data-trick-output]");
    if (!youtubeId || !(output instanceof HTMLElement)) return;

    output.textContent = `{
  id: ${JSON.stringify(`${toySlug}-${slugify(title)}-${today}`)},
  toySlug: ${JSON.stringify(toySlug)},
  title: ${JSON.stringify(title)},
  date: ${JSON.stringify(today)},
  tag: "practice",
  youtubeId: ${JSON.stringify(youtubeId)},
  notes: ${JSON.stringify(notes)},
},`;
  });
</script>
