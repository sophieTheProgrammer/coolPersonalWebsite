---
import DoodleImage from "./DoodleImage.astro";

type Props = {
  src?: string;
};

const { src } = Astro.props;
---

<DoodleImage
  src={src}
  alt="Hand-drawn animation of Sophie spinning"
  variant="avatar"
  animation="none"
  fetchPriority="high"
  reducedMotionSrc="sophie-spin-still.png"
/>
