---
import type { Artwork } from "../data/artworks";

type Props = {
  artwork: Artwork;
  index: number;
};

const { artwork, index } = Astro.props;
const [first, second, third] = artwork.palette;
const hasImage = Boolean(artwork.imageSrc);
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const mediaSrc = artwork.imageSrc?.startsWith("/")
  ? `${base}${artwork.imageSrc.slice(1)}`
  : artwork.imageSrc;
const processSources = (artwork.processSrcs?.length ? artwork.processSrcs : artwork.processSrc ? [artwork.processSrc] : [])
  .map((src) => src.startsWith("/") ? `${base}${src.slice(1)}` : src);
const processSrc = processSources[0];
const isPdf = mediaSrc?.toLowerCase().endsWith(".pdf");
const isFeatured = Boolean(artwork.featured);
---

<article
  class="art-packet-tile group bg-[var(--color-card)] transition hover:-translate-y-1 hover:shadow-lg"
  data-art-featured={isFeatured ? "" : undefined}
>
  <div
    class="art-packet-tile__media relative overflow-hidden rounded-t-[inherit]"
    style={hasImage ? undefined : `background: linear-gradient(135deg, ${first}, ${second} 58%, ${third});`}
  >
    {
      mediaSrc && isPdf ? (
        <iframe
          class="block aspect-[3/4] min-h-80 w-full bg-white"
          src={mediaSrc}
          title={artwork.title}
          loading="lazy"
        />
      ) : mediaSrc ? (
        <button
          class="art-lightbox-trigger group/lightbox flex w-full cursor-zoom-in items-center justify-center text-left"
          type="button"
          data-art-lightbox-trigger
          data-art-src={mediaSrc}
          data-art-process-srcs={JSON.stringify(processSources)}
          data-art-title={artwork.title}
        >
          <img
            class:list={[
              "block h-auto w-full transition duration-300",
              processSrc ? "group-hover:opacity-0 group-focus-within:opacity-0 group-hover/lightbox:opacity-0 group-focus/lightbox:opacity-0" : "",
            ]}
            src={mediaSrc}
            alt={artwork.title}
            loading="lazy"
          />
          {
            processSrc && (
              <img
                class="art-packet-tile__hover-image absolute inset-0 h-full w-full object-contain opacity-0 transition duration-300 group-hover:opacity-100 group-focus-within:opacity-100 group-hover/lightbox:opacity-100 group-focus/lightbox:opacity-100"
                src={processSrc}
                alt={`${artwork.title} process sketch`}
                loading="lazy"
              />
            )
          }
        </button>
      ) : (
        <>
          <div class="min-h-64">
            <div class="absolute inset-0 opacity-25 mix-blend-screen art-tile-pattern"></div>
            <div class="absolute right-3 top-3 rounded bg-white/70 px-2 py-1 text-xs font-black backdrop-blur">
              {String(index + 1).padStart(2, "0")}
            </div>
          </div>
        </>
      )
    }
  </div>
  <div class="art-packet-tile__footer p-4">
    <div class="art-packet-tile__title-row">
      <h2 class="text-xl font-black">{artwork.title}</h2>
      {
        processSources.length > 0 && (
          <div class="art-packet-tile__process-badges" aria-label={`${artwork.title} process previews`}>
            {
              processSources.slice(0, 2).map((src, processIndex) => (
                <button
                  class="art-packet-tile__process-badge"
                  type="button"
                  data-art-lightbox-trigger
                  data-art-src={mediaSrc}
                  data-art-process-srcs={JSON.stringify(processSources)}
                  data-art-start-index={String(processIndex)}
                  data-art-title={artwork.title}
                  aria-label={`Open process image ${processIndex + 1} for ${artwork.title}`}
                >
                  <img src={src} alt="" loading="lazy" />
                </button>
              ))
            }
          </div>
        )
      }
    </div>
  </div>
</article>
