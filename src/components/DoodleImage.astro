---
import { existsSync } from "node:fs";
import { join } from "node:path";

type Props = {
  src?: string;
  alt: string;
  label?: string;
  variant?: "avatar" | "icon" | "sticker" | "cover" | "accent";
  animation?: "float" | "wiggle" | "bob" | "none";
  hideWhenMissing?: boolean;
  fetchPriority?: "high" | "low" | "auto";
  reducedMotionSrc?: string;
};

const {
  src,
  alt,
  label,
  variant = "icon",
  animation = "none",
  hideWhenMissing = false,
  fetchPriority = "auto",
  reducedMotionSrc,
} = Astro.props;

const normalizedSrc = src
  ?.replace(/^\/?doodles\//, "")
  .replace(/^\/+/, "");
const hasImage = Boolean(
  normalizedSrc &&
    existsSync(join(process.cwd(), "public", "doodles", normalizedSrc)),
);
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const publicSrc = hasImage ? `${base}doodles/${normalizedSrc}` : "";
const normalizedReducedMotionSrc = reducedMotionSrc
  ?.replace(/^\/?doodles\//, "")
  .replace(/^\/+/, "");
const hasReducedMotionImage = Boolean(
  normalizedReducedMotionSrc &&
    existsSync(join(process.cwd(), "public", "doodles", normalizedReducedMotionSrc)),
);
const publicReducedMotionSrc = hasReducedMotionImage
  ? `${base}doodles/${normalizedReducedMotionSrc}`
  : "";
const hasFallback = Astro.slots.has("fallback");
const isToyIcon = variant === "icon";
---

{
  !hasImage && hideWhenMissing ? null : (
    <figure
      class:list={[
        "doodle-image",
        `doodle-image--${variant}`,
        animation !== "none" ? `doodle-image--${animation}` : "",
        hasImage ? "doodle-image--ready" : "doodle-image--placeholder",
      ]}
    >
      {
        hasImage ? (
          <picture>
            {hasReducedMotionImage && <source media="(prefers-reduced-motion: reduce)" srcset={publicReducedMotionSrc} />}
            <img
              src={publicSrc}
              alt={alt}
              loading={isToyIcon ? "eager" : "lazy"}
              fetchpriority={fetchPriority}
              decoding="async"
              width={isToyIcon ? 512 : undefined}
              height={isToyIcon ? 512 : undefined}
            />
          </picture>
        ) : hasFallback ? (
          <slot name="fallback" />
        ) : (
          <div class="doodle-image__fallback" role="img" aria-label={alt}>
            <span>{label ?? "draw me"}</span>
          </div>
        )
      }
    </figure>
  )
}
