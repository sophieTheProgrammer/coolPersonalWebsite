---
import VolumeDrawingCard from "../../../components/VolumeDrawingCard.astro";
import ArtFlowGrid from "../../../components/ArtFlowGrid.astro";
import {
  artVolumes,
  getArtVolumeBySlug,
  getArtworksForVolume,
} from "../../../data/artworks";
import BaseLayout from "../../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return artVolumes.map((volume) => ({
    params: { slug: volume.slug },
  }));
}

const { slug } = Astro.params;
const volume = slug ? getArtVolumeBySlug(slug) : undefined;
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

if (!volume) {
  return Astro.redirect(`${base}art/`);
}

const drawings = getArtworksForVolume(volume.slug);
---

<BaseLayout
  title={`${volume.title} | Art | Cool Personal Website`}
  description={`${volume.title} drawing packet.`}
>
  <main class="page-shell">
    <section class="art-wide-frame">
      <a
        class="inline-flex rounded bg-white/50 px-3 py-2 text-sm font-bold text-[var(--color-muted)] transition hover:bg-white/80 hover:text-[var(--color-ink)]"
        href={`${base}art/`}
      >
        Back to volumes
      </a>

      <div class="section-rhythm--tight">
        <div data-packet-open>
          <h1 class="text-5xl font-black leading-none">{volume.title}</h1>
        </div>
      </div>

      <section class="section-rhythm--tight" aria-labelledby="drawing-pack-heading">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <h2 id="drawing-pack-heading" class="text-3xl font-black">
              Inside this volume
            </h2>
          </div>
          <p class="max-w-md text-sm font-semibold leading-6 text-[var(--color-muted)]">
            {drawings.length} pieces in this drawing packet.
          </p>
        </div>

        <ArtFlowGrid className="packet-drawing-grid mt-5">
          {
            drawings.map((artwork, index) => (
              <div data-art-flow-item data-packet-drawing data-art-flow-wide={artwork.featured ? "" : undefined}>
                <VolumeDrawingCard artwork={artwork} index={index} />
              </div>
            ))
          }
        </ArtFlowGrid>
      </section>

      <dialog class="art-lightbox" data-art-lightbox>
        <div class="art-lightbox__inner">
          <div class="art-lightbox__toolbar">
            <h2 data-art-lightbox-title></h2>
            <div class="art-lightbox__actions">
              <button class="site-button px-3 py-2 text-sm" type="button" data-art-lightbox-toggle hidden>
                Show process
              </button>
              <button class="site-button px-3 py-2 text-sm" type="button" data-art-lightbox-close>
                Close
              </button>
            </div>
          </div>
          <img data-art-lightbox-image alt="" />
        </div>
      </dialog>
    </section>
  </main>
</BaseLayout>

<script>
  import { animate, stagger } from "@motionone/dom";

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!reduceMotion) {
    const intro = document.querySelector("[data-packet-open]");
    const drawings = document.querySelectorAll("[data-packet-drawing]");

    if (intro) {
      animate(
        intro,
        { opacity: [0, 1], transform: ["translateY(14px)", "translateY(0)"] },
        { duration: 0.45, easing: "ease-out" },
      );
    }

    if (drawings.length) {
      animate(
        drawings,
        { opacity: [0, 1], transform: ["translateY(18px)", "translateY(0)"] },
        { duration: 0.42, delay: stagger(0.055, { start: 0.18 }), easing: "ease-out" },
      );
    }
  }

  const lightbox = document.querySelector<HTMLDialogElement>("[data-art-lightbox]");
  const lightboxImage = document.querySelector<HTMLImageElement>("[data-art-lightbox-image]");
  const lightboxTitle = document.querySelector<HTMLElement>("[data-art-lightbox-title]");
  const lightboxToggle = document.querySelector<HTMLButtonElement>("[data-art-lightbox-toggle]");
  const lightboxClose = document.querySelector<HTMLButtonElement>("[data-art-lightbox-close]");
  let lightboxFinalSrc = "";
  let lightboxProcessSrcs: string[] = [];
  let lightboxProcessIndex = -1;

  const renderLightboxImage = () => {
    if (!lightboxImage) return;
    const processSrc = lightboxProcessIndex >= 0 ? lightboxProcessSrcs[lightboxProcessIndex] : "";
    lightboxImage.src = processSrc || lightboxFinalSrc;
    lightboxImage.alt = lightboxTitle?.textContent ?? "";

    if (lightboxToggle) {
      lightboxToggle.textContent = lightboxProcessIndex < 0
        ? `Show process${lightboxProcessSrcs.length > 1 ? ` (1/${lightboxProcessSrcs.length})` : ""}`
        : lightboxProcessIndex === lightboxProcessSrcs.length - 1
          ? "Show finished"
          : `Next process (${lightboxProcessIndex + 2}/${lightboxProcessSrcs.length})`;
    }
  };

  document.querySelectorAll<HTMLButtonElement>("[data-art-lightbox-trigger]").forEach((trigger) => {
    trigger.addEventListener("click", () => {
      if (!lightbox || !lightboxImage || !lightboxTitle) return;

      lightboxFinalSrc = trigger.dataset.artSrc ?? "";
      try {
        lightboxProcessSrcs = JSON.parse(trigger.dataset.artProcessSrcs ?? "[]");
      } catch {
        lightboxProcessSrcs = [];
      }
      lightboxProcessIndex = -1;
      lightboxTitle.textContent = trigger.dataset.artTitle ?? "Drawing";

      if (lightboxToggle) {
        lightboxToggle.hidden = lightboxProcessSrcs.length === 0;
      }

      renderLightboxImage();
      lightbox.showModal();
    });
  });

  lightboxToggle?.addEventListener("click", () => {
    lightboxProcessIndex = lightboxProcessIndex >= lightboxProcessSrcs.length - 1
      ? -1
      : lightboxProcessIndex + 1;
    renderLightboxImage();
  });

  lightboxClose?.addEventListener("click", () => {
    lightbox?.close();
  });

  lightbox?.addEventListener("click", (event) => {
    if (event.target === lightbox) {
      lightbox.close();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && lightbox?.open) {
      lightbox.close();
    }
  });
</script>
