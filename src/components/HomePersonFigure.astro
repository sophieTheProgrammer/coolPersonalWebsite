---
import DoodleImage from "./DoodleImage.astro";

type Props = {
  src: string;
  clickSrc: string;
  reducedMotionSrc: string;
};

const { src, clickSrc, reducedMotionSrc } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const clickAnimationSrc = `${base}doodles/${clickSrc.replace(/^\/?doodles\//, "")}`;
---

<button
  class="home-person-figure"
  type="button"
  aria-label="Make Sophie spin"
  data-home-person-figure
  data-click-src={clickAnimationSrc}
>
  <DoodleImage
    src={src}
    reducedMotionSrc={reducedMotionSrc}
    alt="Hand-drawn animation of Sophie spinning"
    variant="avatar"
    animation="none"
    fetchPriority="high"
  />
  <img
    class="home-person-figure__click-animation"
    src={clickAnimationSrc}
    alt=""
    aria-hidden="true"
    decoding="async"
    data-click-animation
  />
</button>

<script>
  document.querySelectorAll<HTMLElement>("[data-home-person-figure]").forEach((figure) => {
    const image = figure.querySelector<HTMLImageElement>("[data-click-animation]");
    const canHover = window.matchMedia("(hover: hover) and (pointer: fine)");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    const replay = () => {
      const clickSrc = figure.dataset.clickSrc;
      if (!image || !clickSrc || reducedMotion.matches) return;

      image.src = `${clickSrc}?replay=${Date.now()}`;
    };

    figure.addEventListener("pointerenter", () => {
      if (!canHover.matches || reducedMotion.matches) return;
      replay();
      figure.classList.add("is-hovering");
    });

    figure.addEventListener("pointerleave", () => {
      figure.classList.remove("is-hovering", "is-pressed");
    });

    figure.addEventListener("pointerdown", () => {
      if (!figure.classList.contains("is-hovering")) replay();
      figure.classList.add("is-pressed");
    });

    const release = () => figure.classList.remove("is-pressed");
    figure.addEventListener("pointerup", release);
    figure.addEventListener("pointercancel", release);

    figure.addEventListener("keydown", (event) => {
      if (event.key !== "Enter" && event.key !== " ") return;
      replay();
      figure.classList.add("is-pressed");
    });

    figure.addEventListener("keyup", (event) => {
      if (event.key === "Enter" || event.key === " ") release();
    });
  });
</script>
