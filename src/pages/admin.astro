---
import BaseLayout from "../layouts/BaseLayout.astro";
import { artVolumes, currentArtwork, getArtworksForVolume, processStages } from "../data/artworks";
import { skillToys } from "../data/skillToys";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const editableProcessStages = processStages as Array<(typeof processStages)[number] & { imageSrc?: string }>;
const libraryPackets = artVolumes.map((volume) => ({
  slug: volume.slug,
  title: volume.title,
  subtitle: volume.subtitle,
  year: volume.year,
  note: volume.note,
  drawings: getArtworksForVolume(volume.slug).map((artwork) => ({
    slug: artwork.slug,
    title: artwork.title,
    year: artwork.year,
    medium: artwork.medium,
    mood: artwork.mood,
    status: artwork.status,
    note: artwork.note,
    palette: artwork.palette,
    imageSrc: artwork.imageSrc ?? "",
    featured: Boolean(artwork.featured),
    processSrcs: artwork.processSrcs ?? (artwork.processSrc ? [artwork.processSrc] : []),
  })),
}));
---

<BaseLayout
  title="Admin Helper | Cool Personal Website"
  description="A local helper page for writing art uploads and generating skill toy data snippets."
>
  <main class="admin-page page-shell">
    <section class="content-frame">
      <h1 class="text-4xl font-black leading-none sm:text-6xl">
        Add stuff locally
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-[var(--color-muted)]">
        Start the local writer with <code>npm run admin:server</code>, then upload
        art files into <code>public/art/</code> and attach image uploads to packets.
      </p>

      <div class="admin-workbench section-rhythm--tight">
        <form class="admin-card admin-panel site-card admin-panel--art" data-art-upload-form>
          <div class="admin-panel__header">
            <h2 class="text-3xl leading-none">Upload art</h2>
            <p>PDF pages can be renamed, paired, and saved into a new or existing packet. GIFs and APNGs stay animated.</p>
          </div>

          <div class="admin-field-grid">
            <label class="field-stack">
              <span>Image or PDF</span>
              <input class="form-field" name="file" type="file" accept="image/*,.apng,.pdf" required />
            </label>
            <label class="field-stack">
              <span>Process/hover images</span>
              <input class="form-field" name="processFile" type="file" accept="image/*,.apng" multiple data-process-file />
            </label>
            <div class="field-stack">
              <span>Drawing layout</span>
              <label class="flex min-h-11 cursor-pointer items-center gap-2 rounded-md border border-[var(--color-line)] bg-white/60 p-3 text-sm font-bold hover:bg-white/80">
                <input
                  class="shrink-0 accent-[var(--color-accent-2)]"
                  name="featured"
                  type="checkbox"
                  value="true"
                  style="appearance: auto; width: 1.1rem; height: 1.1rem;"
                />
                Make this drawing a larger masonry tile
              </label>
            </div>
            <label class="field-stack">
              <span>Packet</span>
              <select class="form-field" name="packetSlug">
                {artVolumes.map((volume) => <option value={volume.slug}>{volume.title}</option>)}
              </select>
            </label>
            <label class="field-stack">
              <span>New packet title for PDF</span>
              <input class="form-field" name="newPacketTitle" placeholder="Leave blank to use selected packet" />
            </label>
            <label class="field-stack">
              <span>Drawing title</span>
              <input class="form-field" name="title" placeholder="Sketchbook scan" required />
            </label>
            <label class="field-stack admin-field-grid__wide">
              <span>Note</span>
              <textarea class="form-field form-field--textarea" name="note" placeholder="Optional tiny note"></textarea>
            </label>
            <label class="field-stack admin-field-grid__wide">
              <span>Existing process image paths</span>
              <textarea class="form-field form-field--textarea" name="processSrcs" placeholder="One /art/ path per line"></textarea>
            </label>
          </div>

          <div class="admin-upload-previews">
            <div class="media-frame admin-upload-preview" data-upload-preview>
              <span>Select an image or PDF</span>
            </div>
            <div class="media-frame admin-upload-preview grid-cols-[repeat(auto-fit,minmax(7rem,1fr))] gap-2 [&_img]:!h-32" data-process-preview>
              <span>Optional process images</span>
            </div>
          </div>
          <div class="admin-pdf-pages" data-pdf-pages hidden></div>
          <div class="flex flex-wrap gap-2">
            <button class="site-button site-button--dark px-4 py-3" type="submit">
              Upload files
            </button>
            <button class="site-button px-4 py-3" type="button" data-save-artwork disabled>
              Save to packet
            </button>
          </div>
          <pre class="admin-output" data-art-output>Writer status will appear here.</pre>
        </form>

        <section
          class="admin-card admin-panel site-card col-span-full"
          data-art-library-manager
          data-library-packets={JSON.stringify(libraryPackets)}
        >
          <div class="admin-panel__header">
            <h2 class="text-3xl leading-none">Art library editor</h2>
            <p>Edit packet details, drawing notes, image paths, featured layout, and ordering.</p>
          </div>

          <div class="admin-library-toolbar">
            <label class="field-stack">
              <span>Packet</span>
              <select class="form-field" data-library-packet>
                {libraryPackets.map((packet) => <option value={packet.slug}>{packet.title}</option>)}
              </select>
            </label>
            <div class="admin-library-actions">
              <button class="site-button px-4 py-3" type="button" data-packet-move="up">Move packet up</button>
              <button class="site-button px-4 py-3" type="button" data-packet-move="down">Move packet down</button>
              <button class="site-button site-button--dark px-4 py-3" type="button" data-delete-packet>
                Delete packet
              </button>
            </div>
          </div>

          <div class="admin-field-grid" data-packet-editor></div>
          <div class="admin-library-drawings" data-library-drawings></div>

          <div class="flex flex-wrap gap-2">
            <button class="site-button site-button--dark px-4 py-3" type="button" data-save-library>
              Save library changes
            </button>
          </div>
          <pre class="admin-output" data-library-output>Select a packet to manage its drawings.</pre>
        </section>

        <form class="admin-card admin-panel site-card admin-panel--process" data-process-slider-form>
          <div class="admin-panel__header">
            <h2 class="text-3xl leading-none">Process slider</h2>
            <p>Upload drawings for each slider step, edit their names, and arrange the order.</p>
          </div>

          <label class="field-stack">
            <span>Slider title</span>
            <input class="form-field" value={currentArtwork.title} data-process-slider-title required />
          </label>

          <div class="admin-process-stages" data-process-stages>
            {
              editableProcessStages.map((stage) => {
                const imageSrc = stage.imageSrc?.startsWith("/")
                  ? `${base}${stage.imageSrc.slice(1)}`
                  : stage.imageSrc;

                return (
                  <article class="admin-process-stage" data-process-stage data-stage-palette={JSON.stringify(stage.palette)}>
                    <div class="media-frame admin-process-stage__preview" data-stage-preview>
                      {imageSrc ? <img src={imageSrc} alt={stage.title} /> : <span>No stage image yet</span>}
                    </div>
                    <input type="hidden" value={stage.imageSrc ?? ""} data-stage-image-src />
                    <label class="field-stack">
                      <span>Stage image</span>
                      <input class="form-field" type="file" accept="image/*,.apng" data-stage-file />
                    </label>
                    <label class="field-stack">
                      <span>Stage title</span>
                      <input class="form-field" value={stage.title} data-stage-title required />
                    </label>
                    <label class="field-stack">
                      <span>Description</span>
                      <textarea class="form-field form-field--textarea" data-stage-description>{stage.description}</textarea>
                    </label>
                    <div class="admin-process-stage__actions">
                      <button class="site-button" type="button" data-stage-move="up" title="Move stage earlier" aria-label={`Move ${stage.title} earlier`}>↑</button>
                      <button class="site-button" type="button" data-stage-move="down" title="Move stage later" aria-label={`Move ${stage.title} later`}>↓</button>
                      <button class="site-button" type="button" data-stage-remove title="Remove stage" aria-label={`Remove ${stage.title}`}>×</button>
                    </div>
                  </article>
                );
              })
            }
          </div>

          <div class="flex flex-wrap gap-2">
            <button class="site-button px-4 py-3" type="button" data-add-process-stage>Add stage</button>
            <button class="site-button site-button--dark px-4 py-3" type="submit">Save process slider</button>
          </div>
          <pre class="admin-output" data-process-output>Slider changes will appear here.</pre>
        </form>

        <form class="admin-card admin-panel site-card admin-panel--tricks" data-trick-form>
          <div class="admin-panel__header">
            <h2 class="text-3xl leading-none">YouTube clip</h2>
            <p>Paste a YouTube URL, check the fetched details, and save it straight to the skill toy log.</p>
          </div>

          <div class="admin-field-grid">
            <label class="field-stack">
              <span>Toy</span>
              <select class="form-field" name="toySlug" data-trick-toy>
                {skillToys.map((toy) => <option value={toy.slug}>{toy.name}</option>)}
              </select>
            </label>
            <label class="field-stack">
              <span>Tag</span>
              <select class="form-field" name="tag" data-trick-tag>
                <option value="practice">practice</option>
                <option value="trick">trick</option>
                <option value="combo">combo</option>
              </select>
            </label>
            <label class="field-stack admin-field-grid__wide">
              <span>YouTube URL or ID</span>
              <input class="form-field" name="youtube" placeholder="https://youtu.be/..." data-trick-youtube required />
            </label>
            <label class="field-stack">
              <span>Title</span>
              <input class="form-field" name="title" placeholder="Fetched from YouTube" data-trick-title />
            </label>
            <label class="field-stack">
              <span>Date</span>
              <input class="form-field" name="date" type="date" data-trick-date />
            </label>
            <label class="field-stack admin-field-grid__wide">
              <span>Trick id</span>
              <input class="form-field" name="id" placeholder="toy-title-01" data-trick-id />
            </label>
            <label class="field-stack admin-field-grid__wide">
              <span>YouTube description</span>
              <textarea class="form-field form-field--textarea" name="youtubeDescription" data-trick-description readonly></textarea>
            </label>
            <label class="field-stack admin-field-grid__wide">
              <span>Notes</span>
              <textarea class="form-field form-field--textarea" name="notes" placeholder="Fetched from YouTube description" data-trick-notes></textarea>
            </label>
          </div>

          <div class="flex flex-wrap gap-2">
            <button class="site-button px-4 py-3" type="button" data-fetch-youtube>
              Refetch YouTube
            </button>
            <button class="site-button site-button--dark px-4 py-3" type="submit">
              Save clip
            </button>
          </div>
          <pre class="admin-output" data-trick-output></pre>
        </form>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import * as pdfjsLib from "pdfjs-dist";
  import pdfWorkerSrc from "pdfjs-dist/build/pdf.worker.mjs?url";

  pdfjsLib.GlobalWorkerOptions.workerSrc = pdfWorkerSrc;

  const writerUrl = "http://127.0.0.1:8787";

  const fetchWriterJson = async (path: string, init?: RequestInit) => {
    let response: Response;

    try {
      response = await fetch(`${writerUrl}${path}`, init);
    } catch {
      throw new Error("Writer unavailable. Run npm run admin:server.");
    }

    let result: { ok?: boolean; error?: string; [key: string]: unknown };
    try {
      result = await response.json();
    } catch {
      throw new Error(`Writer returned ${response.status} without JSON.`);
    }

    if (!response.ok || !result.ok) {
      throw new Error(result.error || `Writer returned ${response.status}.`);
    }

    return result;
  };

  const slugify = (value: string) =>
    value
      .toLowerCase()
      .trim()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-|-$/g, "");

  const getYouTubeId = (value: string) => {
    try {
      const parsed = new URL(value);
      if (parsed.hostname.includes("youtu.be")) {
        return parsed.pathname.split("/").filter(Boolean)[0] ?? value;
      }
      if (parsed.pathname.startsWith("/shorts/")) {
        return parsed.pathname.split("/").filter(Boolean)[1] ?? value;
      }
      return parsed.searchParams.get("v") ?? value;
    } catch {
      return value;
    }
  };

  const artForm = document.querySelector("[data-art-upload-form]");
  const artOutput = document.querySelector("[data-art-output]");
  const saveArtworkButton = document.querySelector("[data-save-artwork]");
  const preview = document.querySelector("[data-upload-preview]");
  const processPreview = document.querySelector("[data-process-preview]");
  const processFileInput = document.querySelector<HTMLInputElement>("[data-process-file]");
  const pdfPagesPreview = document.querySelector("[data-pdf-pages]");
  const packetSelect = document.querySelector<HTMLSelectElement>('[name="packetSlug"]');
  const newPacketInput = document.querySelector<HTMLInputElement>('[name="newPacketTitle"]');
  let uploadedFile: { src: string; kind: "image" | "pdf" } | null = null;
  let uploadedProcessFiles: Array<{ src: string; kind: "image" | "pdf" }> = [];
  type RenderedPdfPage = {
    pageNumber: number;
    dataUrl: string;
    width: number;
    height: number;
  };

  type PdfPagePayload = RenderedPdfPage & {
    title: string;
    role: "final" | "process";
    processPageNumbers?: number[];
    featured: boolean;
  };

  let renderedPdfPages: RenderedPdfPage[] = [];

  const writeOutput = (message: string) => {
    if (artOutput instanceof HTMLElement) {
      artOutput.textContent = message;
    }
  };

  type ManagedDrawing = {
    slug: string;
    title: string;
    year: string;
    medium: string;
    mood: string;
    status: "finished" | "study" | "wip";
    note: string;
    palette: string[];
    imageSrc: string;
    featured: boolean;
    processSrcs: string[];
  };

  type ManagedPacket = {
    slug: string;
    title: string;
    subtitle: string;
    year: string;
    note: string;
    drawings: ManagedDrawing[];
  };

  const libraryManager = document.querySelector<HTMLElement>("[data-art-library-manager]");
  const libraryPacketSelect = document.querySelector<HTMLSelectElement>("[data-library-packet]");
  const packetEditor = document.querySelector<HTMLElement>("[data-packet-editor]");
  const libraryDrawings = document.querySelector<HTMLElement>("[data-library-drawings]");
  const libraryOutput = document.querySelector<HTMLElement>("[data-library-output]");
  const saveLibraryButton = document.querySelector<HTMLButtonElement>("[data-save-library]");
  const deletePacketButton = document.querySelector<HTMLButtonElement>("[data-delete-packet]");
  const packetMoveButtons = document.querySelectorAll<HTMLButtonElement>("[data-packet-move]");
  let managedPackets: ManagedPacket[] = [];
  let oldLibraryAssetPaths: string[] = [];
  let pendingLibraryDelete = "";

  try {
    managedPackets = JSON.parse(libraryManager?.dataset.libraryPackets ?? "[]");
  } catch {
    managedPackets = [];
  }

  const publicBase = import.meta.env.BASE_URL.endsWith("/")
    ? import.meta.env.BASE_URL
    : `${import.meta.env.BASE_URL}/`;
  const publicAssetSrc = (src: string) => src.startsWith("/")
    ? `${publicBase}${src.slice(1)}`
    : src;

  const currentPacket = () =>
    managedPackets.find((item) => item.slug === libraryPacketSelect?.value);

  const setLibraryOutput = (message: string) => {
    if (libraryOutput) libraryOutput.textContent = message;
  };

  const createLibraryField = (
    labelText: string,
    value: string,
    onInput: (value: string) => void,
    multiline = false,
  ) => {
    const label = document.createElement("label");
    label.className = "field-stack";
    const span = document.createElement("span");
    span.textContent = labelText;
    const input = multiline ? document.createElement("textarea") : document.createElement("input");
    input.className = multiline ? "form-field form-field--textarea" : "form-field";
    input.value = value;
    input.addEventListener("input", () => onInput(input.value));
    label.append(span, input);
    return label;
  };

  const renderPacketEditor = (packet?: ManagedPacket) => {
    if (!packetEditor) return;
    packetEditor.replaceChildren();

    if (!packet) return;

    packetEditor.append(
      createLibraryField("Packet title", packet.title, (value) => {
        packet.title = value;
        refreshPacketOptions(packet.slug);
      }),
      createLibraryField("Subtitle", packet.subtitle, (value) => {
        packet.subtitle = value;
      }),
      createLibraryField("Year", packet.year, (value) => {
        packet.year = value;
      }),
      createLibraryField("Packet note", packet.note, (value) => {
        packet.note = value;
      }, true),
    );
  };

  const renderManagedDrawings = () => {
    try {
      if (!libraryDrawings || !libraryPacketSelect) return;
      const packet = currentPacket();
      libraryDrawings.replaceChildren();
      renderPacketEditor(packet);

      if (!packet?.drawings.length) {
        const empty = document.createElement("p");
        empty.className = "text-sm font-semibold text-[var(--color-muted)]";
        empty.textContent = packet ? "This packet has no drawings." : "No packets left.";
        libraryDrawings.append(empty);
      } else {
        packet.drawings.forEach((drawing, index) => {
        const card = document.createElement("article");
        card.className = "admin-library-drawing";
        card.dataset.libraryDrawingCard = drawing.slug;

        const previewFrame = document.createElement("div");
        previewFrame.className = "media-frame admin-library-drawing__preview";
        if (drawing.imageSrc) {
          const image = document.createElement(drawing.imageSrc.toLowerCase().endsWith(".pdf") ? "iframe" : "img");
          image.src = publicAssetSrc(drawing.imageSrc);
          image.title = drawing.title;
          image.setAttribute("alt", drawing.title);
          previewFrame.replaceChildren(image);
        } else {
          const empty = document.createElement("span");
          empty.textContent = "No image";
          previewFrame.append(empty);
        }

        const fields = document.createElement("div");
        fields.className = "admin-library-drawing__fields";
        fields.append(
          createLibraryField("Drawing title", drawing.title, (value) => {
            drawing.title = value;
          }),
          createLibraryField("Main image path", drawing.imageSrc, (value) => {
            drawing.imageSrc = value;
          }),
          createLibraryField("Description", drawing.note, (value) => {
            drawing.note = value;
          }, true),
          createLibraryField("Process image paths", drawing.processSrcs.join("\n"), (value) => {
            drawing.processSrcs = value.split(/[\n,]+/).map((src) => src.trim()).filter(Boolean);
          }, true),
        );

        const featuredLabel = document.createElement("label");
        featuredLabel.className = "admin-library-check";
        const featuredInput = document.createElement("input");
        featuredInput.type = "checkbox";
        featuredInput.checked = drawing.featured;
        featuredInput.addEventListener("change", () => {
          drawing.featured = featuredInput.checked;
        });
        featuredLabel.append(featuredInput, " Featured");

        const imageUploadLabel = document.createElement("label");
        imageUploadLabel.className = "field-stack";
        const imageUploadText = document.createElement("span");
        imageUploadText.textContent = "Replace image";
        const imageUpload = document.createElement("input");
        imageUpload.className = "form-field";
        imageUpload.type = "file";
        imageUpload.accept = "image/*,.apng,.pdf";
        imageUpload.addEventListener("change", async () => {
          const file = imageUpload.files?.[0];
          if (!file) return;

          const previousImage = drawing.imageSrc;
          const body = new FormData();
          body.append("file", file);
          setLibraryOutput(`Uploading replacement for ${drawing.title}...`);

          try {
            const result = await fetchWriterJson("/api/upload", {
              method: "POST",
              body,
            }) as { file?: { src: string } };
            if (!result.file?.src) throw new Error("Upload did not return a file path.");
            if (previousImage && previousImage !== result.file.src) {
              oldLibraryAssetPaths = [...new Set([...oldLibraryAssetPaths, previousImage])];
            }
            drawing.imageSrc = result.file.src;
            setLibraryOutput(`Updated image path for ${drawing.title}. Save library changes to write it.`);
            renderManagedDrawings();
          } catch (error) {
            setLibraryOutput(`Could not replace image.\n${error}`);
          }
        });
        imageUploadLabel.append(imageUploadText, imageUpload);

        const actions = document.createElement("div");
        actions.className = "admin-library-actions";

        const moveUp = document.createElement("button");
        moveUp.className = "site-button";
        moveUp.type = "button";
        moveUp.textContent = "Move up";
        moveUp.disabled = index === 0;
        moveUp.addEventListener("click", () => {
          if (index === 0) return;
          packet.drawings.splice(index - 1, 0, packet.drawings.splice(index, 1)[0]);
          renderManagedDrawings();
        });

        const moveDown = document.createElement("button");
        moveDown.className = "site-button";
        moveDown.type = "button";
        moveDown.textContent = "Move down";
        moveDown.disabled = index === packet.drawings.length - 1;
        moveDown.addEventListener("click", () => {
          if (index >= packet.drawings.length - 1) return;
          packet.drawings.splice(index + 1, 0, packet.drawings.splice(index, 1)[0]);
          renderManagedDrawings();
        });

        const remove = document.createElement("button");
        remove.className = "site-button site-button--dark";
        remove.type = "button";
        remove.textContent = "Delete drawing";
        remove.addEventListener("click", () => {
          const deleteKey = `drawing:${packet.slug}:${drawing.slug}`;
          if (pendingLibraryDelete !== deleteKey) {
            pendingLibraryDelete = deleteKey;
            remove.textContent = "Click again to delete";
            setLibraryOutput(`Click Delete drawing again to remove "${drawing.title}" from "${packet.title}".`);
            return;
          }
          pendingLibraryDelete = "";
          packet.drawings = packet.drawings.filter((item) => item.slug !== drawing.slug);
          renderManagedDrawings();
          setLibraryOutput("Drawing removed from this packet. Save library changes to write it.");
        });

        actions.append(moveUp, moveDown, remove);
        card.append(previewFrame, fields, featuredLabel, imageUploadLabel, actions);
        libraryDrawings.append(card);
      });
      }

      const hasPacket = Boolean(packet);
      if (deletePacketButton) deletePacketButton.disabled = !hasPacket;
      saveLibraryButton?.toggleAttribute("disabled", !hasPacket);
      packetMoveButtons.forEach((button) => {
        const index = packet ? managedPackets.findIndex((item) => item.slug === packet.slug) : -1;
        button.disabled = !packet || (button.dataset.packetMove === "up" ? index <= 0 : index >= managedPackets.length - 1);
      });
    } catch (error) {
      setLibraryOutput(`Could not load art editor.\n${error}`);
    }
  };

  const refreshPacketOptions = (preferredSlug = "") => {
    if (!libraryPacketSelect) return;
    libraryPacketSelect.replaceChildren(
      ...managedPackets.map((packet) => new Option(packet.title, packet.slug)),
    );
    if (preferredSlug && managedPackets.some((packet) => packet.slug === preferredSlug)) {
      libraryPacketSelect.value = preferredSlug;
    }
    renderManagedDrawings();
  };

  const saveLibraryChanges = async () => {
    setLibraryOutput("Saving art library...");

    try {
      const result = await fetchWriterJson("/api/art-library/save", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ packets: managedPackets }),
      }) as { result?: { removedArtworkSlugs?: string[]; oldImageSrcs?: string[] } };
      const oldPaths = [...new Set([
        ...oldLibraryAssetPaths,
        ...(result.result?.oldImageSrcs ?? []),
      ])];
      oldLibraryAssetPaths = [];
      setLibraryOutput(
        `Saved ${managedPackets.length} packet${managedPackets.length === 1 ? "" : "s"}.`
        + `${result.result?.removedArtworkSlugs?.length ? `\nRemoved artwork entries: ${result.result.removedArtworkSlugs.join(", ")}` : ""}`
        + `${oldPaths.length ? `\nOld files kept:\n${oldPaths.join("\n")}` : ""}`,
      );
    } catch (error) {
      setLibraryOutput(`Could not save art library.\n${error}`);
    }
  };

  const deleteLibraryItems = async (mode: "packet") => {
    if (!libraryPacketSelect || !libraryOutput) return;
    const packet = currentPacket();
    if (!packet) return;

    const drawingSlugs = packet.drawings.map((drawing) => drawing.slug);

    const deleteKey = `packet:${packet.slug}`;
    if (pendingLibraryDelete !== deleteKey) {
      pendingLibraryDelete = deleteKey;
      libraryOutput.textContent = `Click Delete packet again to remove "${packet.title}" and its ${packet.drawings.length} drawing${packet.drawings.length === 1 ? "" : "s"}.`;
      return;
    }
    pendingLibraryDelete = "";

    libraryOutput.textContent = "Removing art...";
    try {
      const result = await fetchWriterJson("/api/art-library/delete", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ mode, packetSlug: packet.slug, drawingSlugs }),
      }) as { result?: { removedFromPacket?: string[] } };

      managedPackets = managedPackets.filter((item) => item.slug !== packet.slug);
      packetSelect?.querySelector(`option[value="${CSS.escape(packet.slug)}"]`)?.remove();
      refreshPacketOptions();

      libraryOutput.textContent = `Removed ${result.result?.removedFromPacket?.length ?? 0} drawing${result.result?.removedFromPacket?.length === 1 ? "" : "s"} and the packet.`;
    } catch (error) {
      libraryOutput.textContent = `Could not remove art.\n${error}`;
    }
  };

  libraryPacketSelect?.addEventListener("change", renderManagedDrawings);
  deletePacketButton?.addEventListener("click", () => deleteLibraryItems("packet"));
  saveLibraryButton?.addEventListener("click", saveLibraryChanges);
  packetMoveButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const packet = currentPacket();
      if (!packet) return;
      const index = managedPackets.findIndex((item) => item.slug === packet.slug);
      const nextIndex = button.dataset.packetMove === "up" ? index - 1 : index + 1;
      if (nextIndex < 0 || nextIndex >= managedPackets.length) return;
      managedPackets.splice(nextIndex, 0, managedPackets.splice(index, 1)[0]);
      refreshPacketOptions(packet.slug);
    });
  });
  renderManagedDrawings();

  const renderPdfPages = async (file: File) => {
    if (!(pdfPagesPreview instanceof HTMLElement)) return;

    renderedPdfPages = [];
    pdfPagesPreview.hidden = false;
    pdfPagesPreview.textContent = "Rendering PDF pages...";

    const bytes = new Uint8Array(await file.arrayBuffer());
    const pdf = await pdfjsLib.getDocument({ data: bytes }).promise;
    const pages: RenderedPdfPage[] = [];

    pdfPagesPreview.innerHTML = "";

    for (let pageNumber = 1; pageNumber <= pdf.numPages; pageNumber += 1) {
      const page = await pdf.getPage(pageNumber);
      const baseViewport = page.getViewport({ scale: 1 });
      const scale = Math.min(2.6, 1800 / Math.max(baseViewport.width, baseViewport.height));
      const viewport = page.getViewport({ scale });
      const canvas = document.createElement("canvas");
      const context = canvas.getContext("2d");
      if (!context) continue;

      canvas.width = Math.ceil(viewport.width);
      canvas.height = Math.ceil(viewport.height);
      context.fillStyle = "#ffffff";
      context.fillRect(0, 0, canvas.width, canvas.height);
      await page.render({ canvas, canvasContext: context, viewport }).promise;

      const dataUrl = canvas.toDataURL("image/png");
      pages.push({ pageNumber, dataUrl, width: canvas.width, height: canvas.height });

      const pageCard = document.createElement("article");
      pageCard.className = "admin-pdf-page";
      pageCard.dataset.pdfPage = String(pageNumber);

      const includeLabel = document.createElement("label");
      includeLabel.className = "admin-pdf-page__include";

      const checkbox = document.createElement("input");
      checkbox.type = "checkbox";
      checkbox.value = String(pageNumber);
      checkbox.checked = true;
      checkbox.dataset.pdfInclude = String(pageNumber);

      const includeText = document.createElement("span");
      includeText.textContent = `Include page ${pageNumber}`;

      includeLabel.append(checkbox, includeText);

      const image = document.createElement("img");
      image.src = dataUrl;
      image.alt = `PDF page ${pageNumber}`;

      const meta = document.createElement("p");
      meta.className = "admin-pdf-page__meta";
      meta.textContent = `${canvas.width}x${canvas.height}`;

      const controls = document.createElement("div");
      controls.className = "admin-pdf-page__controls";

      const titleLabel = document.createElement("label");
      titleLabel.className = "field-stack";
      const titleText = document.createElement("span");
      titleText.textContent = "Title";
      const titleInput = document.createElement("input");
      titleInput.className = "form-field";
      titleInput.dataset.pdfTitle = String(pageNumber);
      titleInput.value = `${file.name.replace(/\.[^.]+$/, "")} p. ${pageNumber}`;
      titleLabel.append(titleText, titleInput);

      const roleLabel = document.createElement("label");
      roleLabel.className = "field-stack";
      const roleText = document.createElement("span");
      roleText.textContent = "Use as";
      const roleSelect = document.createElement("select");
      roleSelect.className = "form-field";
      roleSelect.dataset.pdfRole = String(pageNumber);
      roleSelect.innerHTML = `
        <option value="final">finished/gallery image</option>
        <option value="process">process/hover image</option>
      `;
      roleLabel.append(roleText, roleSelect);

      const processLabel = document.createElement("label");
      processLabel.className = "field-stack";
      const processText = document.createElement("span");
      processText.textContent = "Process images";
      const processSelect = document.createElement("select");
      processSelect.className = "form-field";
      processSelect.dataset.pdfProcessFor = String(pageNumber);
      processSelect.multiple = true;
      processSelect.size = 3;
      processLabel.append(processText, processSelect);

      const featuredLabel = document.createElement("label");
      featuredLabel.className = "flex min-h-11 cursor-pointer items-center gap-2 rounded-md border border-[var(--color-line)] bg-white/60 p-3 text-sm font-bold hover:bg-white/80";
      const featuredInput = document.createElement("input");
      featuredInput.type = "checkbox";
      featuredInput.dataset.pdfFeatured = String(pageNumber);
      featuredInput.style.appearance = "auto";
      featuredInput.style.width = "1.1rem";
      featuredInput.style.height = "1.1rem";
      featuredLabel.append(featuredInput, " Make this drawing a larger masonry tile");

      controls.append(titleLabel, roleLabel, processLabel, featuredLabel);
      pageCard.append(includeLabel, image, meta, controls);
      pdfPagesPreview.append(pageCard);
    }

    renderedPdfPages = pages;
    syncPdfProcessSelectors();
    writeOutput(`Rendered ${pages.length} PDF page${pages.length === 1 ? "" : "s"} for packet import.`);
  };

  const syncPdfProcessSelectors = () => {
    if (!(pdfPagesPreview instanceof HTMLElement)) return;

    const processOptions = renderedPdfPages.filter((page) => {
      const role = pdfPagesPreview.querySelector<HTMLSelectElement>(`[data-pdf-role="${page.pageNumber}"]`);
      const include = pdfPagesPreview.querySelector<HTMLInputElement>(`[data-pdf-include="${page.pageNumber}"]`);
      return include?.checked && role?.value === "process";
    });

    pdfPagesPreview.querySelectorAll<HTMLSelectElement>("[data-pdf-process-for]").forEach((select) => {
      const pageNumber = Number(select.dataset.pdfProcessFor);
      const currentValues = new Set(Array.from(select.selectedOptions).map((option) => option.value));
      const role = pdfPagesPreview.querySelector<HTMLSelectElement>(`[data-pdf-role="${pageNumber}"]`);

      select.innerHTML = `<option value="">none</option>`;
      processOptions
        .filter((page) => page.pageNumber !== pageNumber)
        .forEach((page) => {
          const title = pdfPagesPreview.querySelector<HTMLInputElement>(`[data-pdf-title="${page.pageNumber}"]`)?.value.trim();
          const option = document.createElement("option");
          option.value = String(page.pageNumber);
          option.textContent = title ? `Page ${page.pageNumber}: ${title}` : `Page ${page.pageNumber}`;
          select.append(option);
        });

      Array.from(select.options).forEach((option) => {
        option.selected = currentValues.has(option.value);
      });
      select.disabled = role?.value === "process";
    });
  };

  const selectPacket = (slug: string, title?: string) => {
    if (!packetSelect || !slug) return;

    let option = Array.from(packetSelect.options).find((item) => item.value === slug);

    if (!option) {
      option = new Option(title || slug, slug);
      packetSelect.append(option);
    } else if (title) {
      option.textContent = title;
    }

    packetSelect.value = slug;
  };

  const handlePdfPageControlUpdate = (event: Event) => {
    const target = event.target;

    if (
      target instanceof HTMLSelectElement ||
      target instanceof HTMLInputElement
    ) {
      syncPdfProcessSelectors();
    }
  };

  pdfPagesPreview?.addEventListener("change", handlePdfPageControlUpdate);
  pdfPagesPreview?.addEventListener("input", handlePdfPageControlUpdate);

  const renderPreview = async (file: File) => {
    if (!(preview instanceof HTMLElement)) return;
    const url = URL.createObjectURL(file);
    renderedPdfPages = [];

    if (pdfPagesPreview instanceof HTMLElement) {
      pdfPagesPreview.hidden = true;
      pdfPagesPreview.innerHTML = "";
    }

    if (file.type === "application/pdf") {
      preview.innerHTML = `<iframe title="PDF preview" src="${url}"></iframe>`;
      await renderPdfPages(file);
      return;
    }

    preview.innerHTML = `<img src="${url}" alt="Upload preview" />`;
  };

  artForm?.querySelector<HTMLInputElement>('input[type="file"]')?.addEventListener("change", async (event) => {
    const input = event.currentTarget;
    if (!(input instanceof HTMLInputElement)) return;
    const file = input.files?.[0];
    uploadedFile = null;
    uploadedProcessFiles = [];

    if (saveArtworkButton instanceof HTMLButtonElement) {
      saveArtworkButton.disabled = true;
    }

    if (file) {
      const isPdf = file.type === "application/pdf";

      if (processFileInput) {
        processFileInput.disabled = isPdf;
        if (isPdf) processFileInput.value = "";
      }
      if (processPreview instanceof HTMLElement) {
        processPreview.innerHTML = isPdf
          ? "<span>Pair PDF process pages below</span>"
          : "<span>Optional process images</span>";
      }

      await renderPreview(file);
      writeOutput(`Ready to upload: ${file.name}`);
    }
  });

  processFileInput?.addEventListener("change", () => {
    const files = Array.from(processFileInput.files ?? []);
    uploadedProcessFiles = [];

    if (!(processPreview instanceof HTMLElement)) return;

    if (files.length === 0) {
      processPreview.innerHTML = "<span>Optional process images</span>";
      return;
    }

    processPreview.innerHTML = files
      .map((file, index) => `<img src="${URL.createObjectURL(file)}" alt="Process image preview ${index + 1}" />`)
      .join("");
    writeOutput(`Ready to upload ${files.length} process image${files.length === 1 ? "" : "s"}.`);
  });

  artForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const form = event.currentTarget;
    if (!(form instanceof HTMLFormElement)) return;

    const data = new FormData(form);
    writeOutput("Uploading to local writer...");

    try {
      const result = await fetchWriterJson("/api/upload", {
        method: "POST",
        body: data,
      }) as { file: { src: string; kind: "image" | "pdf" }; processFiles?: Array<{ src: string; kind: "image" | "pdf" }> };

      uploadedFile = result.file;
      uploadedProcessFiles = result.processFiles ?? [];
      if (saveArtworkButton instanceof HTMLButtonElement) {
        saveArtworkButton.disabled = false;
      }

      writeOutput(
        uploadedFile?.kind === "pdf"
          ? `Uploaded ${result.file.src}\nReady to save this PDF into the selected packet.`
          : `Uploaded ${result.file.src}${uploadedProcessFiles.length ? `\nUploaded ${uploadedProcessFiles.length} process image${uploadedProcessFiles.length === 1 ? "" : "s"}` : ""}\nReady to save this image into the selected packet.`,
      );
    } catch (error) {
      writeOutput(`Writer unavailable or failed.\nRun: npm run admin:server\n\n${error}`);
    }
  });

  saveArtworkButton?.addEventListener("click", async () => {
    if (!(artForm instanceof HTMLFormElement) || !uploadedFile) {
      return;
    }

    const data = new FormData(artForm);
    writeOutput("Writing drawing data...");

    try {
      if (uploadedFile.kind === "pdf") {
        const selectedPageNumbers = new Set(
          Array.from(document.querySelectorAll<HTMLInputElement>("[data-pdf-include]:checked"))
            .map((input) => Number(input.value)),
        );
        const pages: PdfPagePayload[] = renderedPdfPages
          .filter((page) => selectedPageNumbers.has(page.pageNumber))
          .map((page) => {
            const titleInput = document.querySelector<HTMLInputElement>(`[data-pdf-title="${page.pageNumber}"]`);
            const roleInput = document.querySelector<HTMLSelectElement>(`[data-pdf-role="${page.pageNumber}"]`);
            const processInput = document.querySelector<HTMLSelectElement>(`[data-pdf-process-for="${page.pageNumber}"]`);
            const featuredInput = document.querySelector<HTMLInputElement>(`[data-pdf-featured="${page.pageNumber}"]`);
            const role = roleInput?.value === "process" ? "process" : "final";

            return {
              ...page,
              title: titleInput?.value.trim() || `${String(data.get("title") ?? "PDF page")} p. ${page.pageNumber}`,
              role,
              processPageNumbers: role === "final"
                ? Array.from(processInput?.selectedOptions ?? []).map((option) => Number(option.value))
                : undefined,
              featured: role === "final" && Boolean(featuredInput?.checked),
            };
          });

        const result = await fetchWriterJson("/api/pdf-pages", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            packetSlug: data.get("packetSlug"),
            newPacketTitle: data.get("newPacketTitle"),
            title: data.get("title"),
            note: data.get("note"),
            pages,
          }),
        }) as { artwork: { packetSlug: string; packetTitle?: string; createdPacket?: unknown; slugs: string[] } };

        selectPacket(result.artwork.packetSlug, result.artwork.packetTitle);
        if (result.artwork.createdPacket && newPacketInput) {
          newPacketInput.value = "";
        }

        writeOutput(`Saved PDF pages to ${result.artwork.packetTitle || result.artwork.packetSlug}: ${result.artwork.slugs.join(", ")}\nThe packet selector now points at that packet.`);
        return;
      }

      const result = await fetchWriterJson("/api/artwork", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          packetSlug: data.get("packetSlug"),
          title: data.get("title"),
          note: data.get("note"),
          imageSrc: uploadedFile.src,
          processSrcs: [
            ...uploadedProcessFiles.map((file) => file.src),
            ...String(data.get("processSrcs") ?? "").split(/[\n,]+/).map((src) => src.trim()).filter(Boolean),
          ],
          featured: data.get("featured") === "true",
          kind: uploadedFile.kind,
        }),
      }) as { artwork: { slug: string } };

      writeOutput(`Saved drawing: ${result.artwork.slug}\nRun npm run build or refresh dev server to see it.`);
    } catch (error) {
      writeOutput(`Could not save drawing.\n${error}`);
    }
  });

  const processSliderForm = document.querySelector<HTMLFormElement>("[data-process-slider-form]");
  const processStagesContainer = document.querySelector<HTMLElement>("[data-process-stages]");
  const processOutput = document.querySelector<HTMLElement>("[data-process-output]");
  const processSliderTitle = document.querySelector<HTMLInputElement>("[data-process-slider-title]");
  const addProcessStageButton = document.querySelector<HTMLButtonElement>("[data-add-process-stage]");
  const defaultStagePalette = ["#fff8ed", "#d94f68", "#247d70"];

  const createProcessStageCard = () => {
    const stage = document.createElement("article");
    stage.className = "admin-process-stage";
    stage.dataset.processStage = "";
    stage.dataset.stagePalette = JSON.stringify(defaultStagePalette);
    stage.innerHTML = `
      <div class="media-frame admin-process-stage__preview" data-stage-preview><span>No stage image yet</span></div>
      <input type="hidden" value="" data-stage-image-src>
      <label class="field-stack">
        <span>Stage image</span>
        <input class="form-field" type="file" accept="image/*,.apng" data-stage-file>
      </label>
      <label class="field-stack">
        <span>Stage title</span>
        <input class="form-field" value="New stage" data-stage-title required>
      </label>
      <label class="field-stack">
        <span>Description</span>
        <textarea class="form-field form-field--textarea" data-stage-description></textarea>
      </label>
      <div class="admin-process-stage__actions">
        <button class="site-button" type="button" data-stage-move="up" title="Move stage earlier" aria-label="Move stage earlier">↑</button>
        <button class="site-button" type="button" data-stage-move="down" title="Move stage later" aria-label="Move stage later">↓</button>
        <button class="site-button" type="button" data-stage-remove title="Remove stage" aria-label="Remove stage">×</button>
      </div>
    `;
    return stage;
  };

  addProcessStageButton?.addEventListener("click", () => {
    processStagesContainer?.append(createProcessStageCard());
  });

  processStagesContainer?.addEventListener("change", (event) => {
    const input = event.target;
    if (!(input instanceof HTMLInputElement) || !input.matches("[data-stage-file]")) return;

    const file = input.files?.[0];
    const preview = input.closest("[data-process-stage]")?.querySelector<HTMLElement>("[data-stage-preview]");
    if (!file || !preview) return;

    preview.innerHTML = `<img src="${URL.createObjectURL(file)}" alt="Stage image preview">`;
  });

  processStagesContainer?.addEventListener("click", (event) => {
    const button = event.target instanceof Element ? event.target.closest<HTMLButtonElement>("button") : null;
    const stage = button?.closest<HTMLElement>("[data-process-stage]");
    if (!button || !stage || !processStagesContainer) return;

    if (button.matches("[data-stage-remove]")) {
      if (processStagesContainer.querySelectorAll("[data-process-stage]").length > 1) stage.remove();
      return;
    }

    const direction = button.dataset.stageMove;
    if (direction === "up" && stage.previousElementSibling) {
      processStagesContainer.insertBefore(stage, stage.previousElementSibling);
    } else if (direction === "down" && stage.nextElementSibling) {
      processStagesContainer.insertBefore(stage.nextElementSibling, stage);
    }
  });

  processSliderForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!processStagesContainer) return;

    const cards = Array.from(processStagesContainer.querySelectorAll<HTMLElement>("[data-process-stage]"));
    const stages = cards.map((card, index) => ({
      label: String(index + 1).padStart(2, "0"),
      title: card.querySelector<HTMLInputElement>("[data-stage-title]")?.value.trim() || `Stage ${index + 1}`,
      description: card.querySelector<HTMLTextAreaElement>("[data-stage-description]")?.value.trim() || "",
      imageSrc: card.querySelector<HTMLInputElement>("[data-stage-image-src]")?.value || "",
      palette: JSON.parse(card.dataset.stagePalette || JSON.stringify(defaultStagePalette)),
    }));
    const body = new FormData();
    body.append("title", processSliderTitle?.value.trim() || "Sunset");
    body.append("stages", JSON.stringify(stages));

    cards.forEach((card, index) => {
      const file = card.querySelector<HTMLInputElement>("[data-stage-file]")?.files?.[0];
      if (file) body.append(`stageFile-${index}`, file);
    });

    if (processOutput) processOutput.textContent = "Saving process slider...";

    try {
      const result = await fetchWriterJson("/api/process-slider", { method: "POST", body }) as {
        title: string;
        stages: Array<{ title: string; imageSrc?: string }>;
      };

      cards.forEach((card, index) => {
        const saved = result.stages[index];
        const imageSrc = card.querySelector<HTMLInputElement>("[data-stage-image-src]");
        const file = card.querySelector<HTMLInputElement>("[data-stage-file]");
        const preview = card.querySelector<HTMLElement>("[data-stage-preview]");
        if (imageSrc) imageSrc.value = saved.imageSrc || "";
        if (file) file.value = "";
        if (preview && saved.imageSrc) {
          const image = document.createElement("img");
          image.src = publicAssetSrc(saved.imageSrc);
          image.alt = saved.title;
          preview.replaceChildren(image);
        }
      });

      if (processSliderTitle) processSliderTitle.value = result.title;
      if (processOutput) processOutput.textContent = `Saved ${result.title} with ${result.stages.length} process stages. Refresh Art to see it.`;
    } catch (error) {
      if (processOutput) processOutput.textContent = `Could not save process slider.\n${error}`;
    }
  });

  const trickForm = document.querySelector("[data-trick-form]");
  const trickToy = document.querySelector<HTMLSelectElement>("[data-trick-toy]");
  const trickYoutube = document.querySelector<HTMLInputElement>("[data-trick-youtube]");
  const trickTitle = document.querySelector<HTMLInputElement>("[data-trick-title]");
  const trickDate = document.querySelector<HTMLInputElement>("[data-trick-date]");
  const trickId = document.querySelector<HTMLInputElement>("[data-trick-id]");
  const trickDescription = document.querySelector<HTMLTextAreaElement>("[data-trick-description]");
  const trickNotes = document.querySelector<HTMLTextAreaElement>("[data-trick-notes]");
  const fetchYouTubeButton = document.querySelector<HTMLButtonElement>("[data-fetch-youtube]");
  let trickIdEdited = false;
  let lastFetchedYouTube = "";
  let pendingYouTubeFetch = 0;

  const today = new Date().toISOString().slice(0, 10);

  if (trickDate) {
    trickDate.value = today;
  }

  const buildTrickId = () => {
    const toySlug = trickToy?.value ?? "toy";
    const titleSlug = slugify(trickTitle?.value ?? "") || "youtube-clip";
    const dateSlug = trickDate?.value || today;
    return `${toySlug}-${titleSlug}-${dateSlug}`;
  };

  const syncTrickId = () => {
    if (!trickId || trickIdEdited) return;
    trickId.value = buildTrickId();
  };

  trickId?.addEventListener("input", () => {
    trickIdEdited = true;
  });

  [trickToy, trickTitle, trickDate].forEach((input) => {
    input?.addEventListener("input", syncTrickId);
    input?.addEventListener("change", syncTrickId);
  });

  const fetchYouTubeMetadata = async (force = false) => {
    if (!trickYoutube) return;
    const value = trickYoutube.value.trim();
    if (!value) return;
    const youtubeId = getYouTubeId(value).trim();
    if (!youtubeId || (!force && youtubeId === lastFetchedYouTube)) return;

    const output = document.querySelector("[data-trick-output]");
    if (output instanceof HTMLElement) {
      output.textContent = "Fetching YouTube metadata...";
    }

    try {
      const result = await fetchWriterJson(`/api/youtube-metadata?url=${encodeURIComponent(value)}`) as {
        video: { youtubeId: string; title?: string; description?: string };
      };

      if (trickYoutube) trickYoutube.value = result.video.youtubeId;
      if (trickTitle) trickTitle.value = result.video.title || "";
      if (trickDescription) trickDescription.value = result.video.description || "";
      if (trickNotes && !trickNotes.value) trickNotes.value = result.video.description || "";
      lastFetchedYouTube = result.video.youtubeId;
      syncTrickId();

      if (output instanceof HTMLElement) {
        output.textContent = `Fetched ${result.video.youtubeId}. Edit the details if needed, then save.`;
      }
    } catch (error) {
      if (output instanceof HTMLElement) {
        output.textContent = `Could not fetch YouTube metadata.\n${error}`;
      }
    }
  };

  const queueYouTubeFetch = () => {
    window.clearTimeout(pendingYouTubeFetch);
    pendingYouTubeFetch = window.setTimeout(() => {
      fetchYouTubeMetadata();
    }, 650);
  };

  trickYoutube?.addEventListener("input", queueYouTubeFetch);
  trickYoutube?.addEventListener("paste", queueYouTubeFetch);
  trickYoutube?.addEventListener("blur", () => {
    fetchYouTubeMetadata();
  });

  fetchYouTubeButton?.addEventListener("click", () => {
    fetchYouTubeMetadata(true);
  });

  syncTrickId();

  trickForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const form = event.currentTarget;
    if (!(form instanceof HTMLFormElement)) return;

    const data = new FormData(form);
    const toySlug = String(data.get("toySlug") ?? "");
    const youtubeId = getYouTubeId(String(data.get("youtube") ?? "").trim());
    const title = String(data.get("title") ?? "").trim() || "YouTube title";
    const notes =
      String(data.get("notes") ?? "").trim() ||
      String(data.get("youtubeDescription") ?? "").trim();
    const date = String(data.get("date") ?? "").trim() || today;
    const tag = String(data.get("tag") ?? "practice");
    const id = String(data.get("id") ?? "").trim() || buildTrickId();
    const output = form.querySelector("[data-trick-output]");
    if (!youtubeId || !(output instanceof HTMLElement)) return;

    output.textContent = "Saving clip to the skill toy log...";

    try {
      const result = await fetchWriterJson("/api/skilltoy-clip", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ id, toySlug, title, date, tag, youtubeId, notes }),
      }) as { clip: { title: string; toySlug: string } };

      output.textContent = `Saved ${result.clip.title} to ${result.clip.toySlug}. Refresh the skill toys page to see it.`;
      form.reset();
      if (trickDate) trickDate.value = today;
      trickIdEdited = false;
      lastFetchedYouTube = "";
      syncTrickId();
    } catch (error) {
      output.textContent = `Could not save clip.\n${error}`;
    }
  });
