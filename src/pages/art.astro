---
import ArtProcessWidget from "../components/ArtProcessWidget.astro";
import ArtVolumeCard from "../components/ArtVolumeCard.astro";
import ArtFlowGrid from "../components/ArtFlowGrid.astro";
import { artVolumes } from "../data/artworks";
import BaseLayout from "../layouts/BaseLayout.astro";

const leadingVolumes = artVolumes.slice(0, 4);
const trailingVolumes = artVolumes.slice(4);
---

<BaseLayout
  title="Art | Cool Personal Website"
  description="A small gallery of drawing collections, process work, and sketchbooks."
>
  <main class="art-page-shell page-shell overflow-hidden">
    <section class="art-wide-frame relative z-10">
      <div class="grid gap-8 lg:grid-cols-[0.85fr_1.15fr] lg:items-end">
        <div>
          <h1 class="text-4xl font-black leading-none sm:text-6xl">
            An art gallery
          </h1>
        </div>
      </div>

      <div class="art-gallery-stage feature-panel section-rhythm--tight">
        <div class="mb-3 flex flex-wrap items-center justify-between gap-3 px-1">
          <p class="text-sm font-semibold text-[var(--color-muted)]">
            click a pack to open the drawings inside
          </p>
        </div>
        <ArtFlowGrid className="art-gallery-grid">
          {leadingVolumes.map((volume) => <div data-art-flow-item><ArtVolumeCard volume={volume} /></div>)}
          <div data-art-flow-item data-art-flow-full><ArtProcessWidget /></div>
          {trailingVolumes.map((volume) => <div data-art-flow-item><ArtVolumeCard volume={volume} /></div>)}
        </ArtFlowGrid>
      </div>

    </section>
  </main>
</BaseLayout>
