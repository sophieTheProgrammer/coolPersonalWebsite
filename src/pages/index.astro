---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomePersonFigure from "../components/HomePersonFigure.astro";
import { homeContent } from "../data/site";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

---

<BaseLayout title="Cool Personal Website">
  <main class="page-shell home-page overflow-hidden">
    <section class="content-frame home-landing">
      <header class="home-intro">
        <h1>{homeContent.headline}</h1>
      </header>

      <div class="home-scene">
        <div class="home-portrait-stage">
          <HomePersonFigure
            src={homeContent.studioAvatarDoodle.animated}
            reducedMotionSrc={homeContent.studioAvatarDoodle.still}
          />
        </div>

        <nav class="home-start-menu" aria-label="Go somewhere">
          <p>go somewhere</p>
          <div class="home-start-menu__destinations">
          {
            homeContent.sections.map((section) => (
              <a
                class="home-start-menu__link"
                href={`${base}${section.href}`}
              >
                <span class="home-start-menu__arrow" aria-hidden="true">→</span>
                <span>{section.title}</span>
              </a>
            ))
          }
          </div>

          <div class="home-start-menu__socials" aria-label="Sophie elsewhere online">
            {
              homeContent.socialLinks.map((link) => (
                <a
                  class:list={["home-start-menu__social", `home-start-menu__social--${link.kind}`]}
                  href={link.href}
                  target="_blank"
                  rel="noreferrer"
                  aria-label={link.label}
                  title={link.label}
                >
                  {
                    link.kind === "youtube" ? (
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.3 3.6-6.3 3.6Z" />
                      </svg>
                    ) : (
                      <svg viewBox="0 0 16 16" aria-hidden="true">
                        <path d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82A7.65 7.65 0 0 1 8 3.93a7.65 7.65 0 0 1 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8 8 0 0 0 8 0Z" />
                      </svg>
                    )
                  }
                </a>
              ))
            }
          </div>
        </nav>
      </div>
    </section>
  </main>
</BaseLayout>
