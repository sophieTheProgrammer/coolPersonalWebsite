---
import { currentArtwork, processStages } from "../data/artworks";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const imageStages = processStages as Array<(typeof processStages)[number] & { imageSrc?: string }>;
const stages = imageStages.map((stage) => ({
  ...stage,
  imageSrc: stage.imageSrc?.startsWith("/")
    ? `${base}${stage.imageSrc.slice(1)}`
    : stage.imageSrc,
}));
---

<article
  class="art-process-widget overflow-hidden rounded-lg bg-[var(--color-card)] text-[var(--color-ink)]"
  data-stages={JSON.stringify(stages)}
>
  <div class="art-process-widget__layout">
    <div class="art-process-widget__main">
      <h2 class="text-3xl font-black leading-none">{currentArtwork.title}</h2>

      <div class="mt-4">
        <div
          class="process-preview relative aspect-[16/9] overflow-hidden rounded-lg"
          data-process-preview
          style={`background: linear-gradient(135deg, ${stages[0].palette[0]}, ${stages[0].palette[1]} 55%, ${stages[0].palette[2]});`}
        >
          <img
            class:list={["h-full w-full object-contain", stages[0].imageSrc ? "block" : "hidden"]}
            src={stages[0].imageSrc}
            alt={stages[0].title}
            data-process-image
          />
          <div class:list={["absolute inset-0 opacity-25 art-tile-pattern", stages[0].imageSrc ? "hidden" : ""]} data-process-fallback></div>
          <div class="absolute bottom-4 left-4 rounded-md bg-white/70 px-3 py-2 text-sm font-black text-[var(--color-ink)] backdrop-blur" data-process-label>
            {stages[0].label} / {stages[0].title}
          </div>
        </div>

        <input
          class="mt-5 w-full accent-[var(--color-accent)]"
          data-process-range
          type="range"
          min="0"
          max={stages.length - 1}
          value="0"
          step="1"
          aria-label="Artwork process stage"
        />
      </div>
    </div>

    <div class="art-process-widget__details">
      <div class="rounded-lg bg-white/60 p-4">
        <h3 class="text-2xl font-black" data-process-title>{stages[0].title}</h3>
        <p class="mt-3 leading-7 text-[var(--color-muted)]" data-process-description>
          {stages[0].description}
        </p>
      </div>
    </div>
  </div>
</article>

<script>
  const widgets = document.querySelectorAll(".art-process-widget");

  widgets.forEach((widget) => {
    const stages = JSON.parse(widget.getAttribute("data-stages") ?? "[]") as Array<{
      label: string;
      title: string;
      description: string;
      palette: string[];
      imageSrc?: string;
    }>;
    if (!stages) return;

    const range = widget.querySelector("[data-process-range]");
    const preview = widget.querySelector("[data-process-preview]");
    const label = widget.querySelector("[data-process-label]");
    const title = widget.querySelector("[data-process-title]");
    const description = widget.querySelector("[data-process-description]");
    const image = widget.querySelector("[data-process-image]");
    const fallback = widget.querySelector("[data-process-fallback]");

    if (
      !(range instanceof HTMLInputElement) ||
      !(preview instanceof HTMLElement) ||
      !(label instanceof HTMLElement) ||
      !(title instanceof HTMLElement) ||
      !(description instanceof HTMLElement) ||
      !(image instanceof HTMLImageElement) ||
      !(fallback instanceof HTMLElement)
    ) {
      return;
    }

    const renderStage = () => {
      const stage = stages[Number(range.value)] ?? stages[0];
      preview.style.background = `linear-gradient(135deg, ${stage.palette[0]}, ${stage.palette[1]} 55%, ${stage.palette[2]})`;
      image.src = stage.imageSrc ?? "";
      image.alt = stage.title;
      image.classList.toggle("hidden", !stage.imageSrc);
      image.classList.toggle("block", Boolean(stage.imageSrc));
      fallback.classList.toggle("hidden", Boolean(stage.imageSrc));
      label.textContent = `${stage.label} / ${stage.title}`;
      title.textContent = stage.title;
      description.textContent = stage.description;
    };

    range.addEventListener("input", renderStage);
    renderStage();
  });
</script>
