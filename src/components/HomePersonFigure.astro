---
import DoodleImage from "./DoodleImage.astro";

type Props = {
  src: string;
  hoverSrc: string;
  reducedMotionSrc: string;
};

const { src, hoverSrc, reducedMotionSrc } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const hoverAnimationSrc = `${base}doodles/${hoverSrc.replace(/^\/?doodles\//, "")}`;
---

<div class="home-person-figure">
  <DoodleImage
    src={src}
    reducedMotionSrc={reducedMotionSrc}
    alt="Hand-drawn animation of Sophie spinning"
    variant="avatar"
    animation="none"
    fetchPriority="high"
  />
  <img
    class="home-person-figure__hover-animation"
    src={hoverAnimationSrc}
    alt=""
    aria-hidden="true"
    decoding="async"
  />
</div>
