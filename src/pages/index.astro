---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomePersonFigure from "../components/HomePersonFigure.astro";
import { homeContent } from "../data/site";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const startLinks = [
  ...homeContent.sections.map((section) => ({
    label: section.title,
    href: `${base}${section.href}`,
    kind: "section",
  })),
  ...homeContent.socialLinks.map((link) => ({
    label: link.label,
    href: link.href,
    kind: link.kind,
  })),
];
---

<BaseLayout title="Cool Personal Website">
  <main class="page-shell home-page overflow-hidden">
    <section class="content-frame home-landing">
      <header class="home-intro">
        <h1>{homeContent.headline}</h1>
      </header>

      <div class="home-scene">
        <div class="home-portrait-stage">
          <HomePersonFigure
            webmSrc={homeContent.studioAvatarVideo.webm}
            movSrc={homeContent.studioAvatarVideo.mov}
            posterSrc={homeContent.studioAvatarVideo.poster}
          />
        </div>

        <nav class="home-start-menu" aria-label="Go somewhere">
          <p>go somewhere</p>
          {
            startLinks.map((link) => (
              <a
                class:list={[
                  "home-start-menu__link",
                  link.kind !== "section" && `home-start-menu__link--${link.kind}`,
                ]}
                href={link.href}
                target={link.kind !== "section" ? "_blank" : undefined}
                rel={link.kind !== "section" ? "noreferrer" : undefined}
              >
                <span class="home-start-menu__arrow" aria-hidden="true">→</span>
                <span class="home-start-menu__icon" aria-hidden="true">
                  {link.kind !== "section" && <span></span>}
                </span>
                <span>{link.label}</span>
              </a>
            ))
          }
        </nav>
      </div>
    </section>
  </main>
</BaseLayout>
