---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomePersonFigure from "../components/HomePersonFigure.astro";
import { homeContent } from "../data/site";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title="Cool Personal Website">
  <main class="page-shell home-page overflow-hidden">
    <section class="content-frame home-landing">
      <header class="home-intro">
        <h1>{homeContent.headline}</h1>

        <div class="home-social-links" aria-label="Sophie elsewhere online">
          {
            homeContent.socialLinks.map((link) => (
              <a
                class:list={[
                  "home-social-card group rounded-md bg-[var(--color-card)] px-4 py-3 transition hover:-translate-y-0.5",
                  link.kind === "youtube" ? "home-social-card--youtube" : "home-social-card--github",
                ]}
                href={link.href}
                target="_blank"
                rel="noreferrer"
              >
                <span class="home-social-card__icon" aria-hidden="true">
                  <span></span>
                </span>
                <span class="block font-black">{link.label}</span>
              </a>
            ))
          }
        </div>
      </header>

      <div class="home-scene">
        <div class="home-portrait-stage">
          <HomePersonFigure src={homeContent.studioAvatarDoodle} />
          <span class="home-portrait-caption" aria-hidden="true">me!</span>
        </div>

        <div class="home-sketch-arrow" aria-hidden="true">
          <span></span>
        </div>

        <nav class="home-cabinet" aria-label="Go somewhere">
          <div class="home-cabinet__top">
            <span>go somewhere</span>
          </div>

          <div class="home-cabinet__shelves">
          {
            homeContent.sections.map((section) => (
              <a
                class="home-cabinet__link"
                href={`${base}${section.href}`}
              >
                <span>{section.title}</span>
                <span aria-hidden="true">→</span>
              </a>
            ))
          }
          </div>

          <div class="home-cabinet__base" aria-hidden="true">
            <span></span>
            <span></span>
          </div>
          <span class="home-cabinet__wheel home-cabinet__wheel--left" aria-hidden="true"></span>
          <span class="home-cabinet__wheel home-cabinet__wheel--right" aria-hidden="true"></span>
        </nav>
      </div>
    </section>
  </main>
</BaseLayout>
